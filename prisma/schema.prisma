generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  role      Role      @default(USER)
  listings  Listing[]
  createdAt DateTime  @default(now())
}

model Listing {
  id          Int    @id @default(autoincrement())
  title       String
  description String
  price       Float
  category    String

  ownerId Int
  owner   User @relation(fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  MODERATOR
  ADMIN
}
